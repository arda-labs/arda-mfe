{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@workspace/ui/*": ["./src/*"],
      "@workspace/i18n": ["../i18n/src/index.tsx"],
      "@workspace/core/*": ["../core/src/*"]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
