{
  "name": "arda-mfe",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run --filter './apps/*' build",
    "clear:dev-ports": "bun ./scripts/clear-dev-ports.mjs",
    "dev": "bun run clear:dev-ports && bun run --filter './apps/*' --parallel dev",
    "lint": "bun run --filter './apps/*' --filter './packages/*' lint",
    "format": "bun run --workspaces --parallel format",
    "typecheck": "bun run --filter './apps/*' --filter './packages/*' typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@module-federation/vite": "^1.16.12",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-router-dom": "^7",
    "typescript": "~6",
    "typescript-eslint": "^8"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
