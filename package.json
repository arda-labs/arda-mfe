{
  "name": "arda-mfe",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun ./scripts/build-cloudflare-app.mjs all",
    "build:apps": "bun run --filter './apps/*' build",
    "cf:build": "bun ./scripts/build-cloudflare-app.mjs",
    "cf:build:all": "bun ./scripts/build-cloudflare-app.mjs all",
    "cf:deploy": "bun ./scripts/deploy-cloudflare-app.mjs",
    "clear:dev-ports": "bun ./scripts/clear-dev-ports.mjs",
    "check:i18n": "bun ./scripts/check-i18n.mjs",
    "check:packages": "bun ./scripts/check-package-boundaries.mjs",
    "check:credentials": "bun ./scripts/check-credentialed-fetch.mjs",
    "check:fallbacks": "bun ./scripts/check-no-fail-open-fallbacks.mjs",
    "check:federation": "bun ./scripts/check-federation-compat.mjs",
    "check:pages": "bun ./scripts/check-page-size.mjs",
    "dev": "bun run clear:dev-ports && bun run --filter './apps/*' --parallel dev",
    "lint": "bun run --filter './apps/*' --filter './packages/*' lint",
    "format": "bun run --workspaces --parallel format",
    "typecheck": "bun run check:i18n && bun run check:packages && bun run check:credentials && bun run check:fallbacks && bun run check:federation && bun run check:pages && bun run --filter './apps/*' --filter './packages/*' typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@module-federation/vite": "^1.20.7",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-router-dom": "^7.18.2",
    "typescript": "~6",
    "typescript-eslint": "^8.67.0",
    "wrangler": "^4.125.0"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@assistant-ui/react": "^0.15.17",
    "@assistant-ui/react-markdown": "^0.14.13"
  }
}
