{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "arda-shell",
  "compatibility_date": "2026-08-22",
  "main": "./shell-worker.ts",
  "workers_dev": true,
  "routes": [
    { "pattern": "arda.io.vn/*", "zone_name": "arda.io.vn" }
  ],
  "assets": {
    "directory": "../.cloudflare/dist/shell",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
