{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "arda-mfe-mdm",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "routes": [{ "pattern": "arda.io.vn/mfes/mdm/*", "zone_name": "arda.io.vn" }],
  "assets": { "directory": "../.cloudflare/dist/mdm" },
  "observability": {
    "traces": {
      "enabled": true
    }
  }
}
