{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "arda-mfe-platform",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "routes": [{ "pattern": "arda.io.vn/mfes/platform/*", "zone_name": "arda.io.vn" }],
  "assets": { "directory": "../.cloudflare/dist/platform" }
,
  "observability": {
    "traces": {
      "enabled": true
    }
  }
}
